{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "app.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "data"]
}